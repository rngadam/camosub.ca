---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Événements - CAMO Sports Subaquatiques</title>
    <link>{{ site.url }}/</link>
    <description>Événements à venir du Club CAMO Subaquatique</description>
    <atom:link href="{{ '/events_rss.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    {% for event in site.data.events %}
    <item>
      <title>{{ event.fr.title | xml_escape }}</title>
      <link>{{ site.url }}/#event-{{ event.id }}-fr</link>
      <guid isPermaLink="false">{{ event.id }}</guid>
      <description>{{ event.fr.description | xml_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
