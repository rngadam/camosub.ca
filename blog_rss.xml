---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Blog - Club CAMO Subaquatique</title>
    <link>{{ site.url }}/blog.html</link>
    <description>Dernières nouvelles du Club CAMO Subaquatique</description>
    <atom:link href="{{ '/blog_rss.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    {% for post in site.data.blog.posts %}
    <item>
      <title>{{ post.fr.title | xml_escape }}</title>
      <link>{{ site.url }}/blog.html#{{ post.id }}</link>
      <guid isPermaLink="false">{{ post.id }}</guid>
      <pubDate>{{ post.timestamp | date_to_rfc822 }}</pubDate>
      <description>{{ post.fr.content | default: post.fr.title | xml_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
