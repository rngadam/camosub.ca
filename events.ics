---
layout: null
---
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//CAMO Subaquatique//Jekyll//EN
X-WR-CALNAME;language=fr:CAMO Sports Subaquatiques
X-WR-CALNAME;language=en:CAMO Underwater Sports
X-WR-CALDESC;language=fr:Évènements de CAMO Sports Subaquatiques
X-WR-CALDESC;language=en:Events of CAMO Underwater Sports
X-WR-TIMEZONE:America/Montreal
X-PUBLISHED-TTL:P1D
{% for event in site.data.events %}
BEGIN:VEVENT
UID:{{ event.id }}@camosub.ca
SUMMARY:{{ event.fr.title }}
DESCRIPTION:{{ event.fr.description }}{% if event.fr.organizers %}\n\nOrganisateurs (FR): {{ event.fr.organizers }}{% endif %}{% if event.en.organizers %}\nOrganizers (EN): {{ event.en.organizers }}{% endif %}{% if event.fr.programTitle %}\n\n{{ event.fr.programTitle }}\n{% for item in event.fr.programDetails %}- {{ item }}\n{% endfor %}{% endif %}{% if event.fr.cost %}\nCoût (FR): {{ event.fr.cost }}{% endif %}{% if event.fr.equipmentNeeded %}\nÉquipement (FR): {{ event.fr.equipmentNeeded }}{% endif %}{% if event.fr.notes %}\nNotes (FR): {{ event.fr.notes }}{% endif %}{% if event.en.programTitle %}\n\n{{ event.en.programTitle }}\n{% for item in event.en.programDetails %}- {{ item }}\n{% endfor %}{% endif %}{% if event.en.cost %}\nCost (EN): {{ event.en.cost }}{% endif %}{% if event.en.equipmentNeeded %}\nEquipment (EN): {{ event.en.equipmentNeeded }}{% endif %}{% if event.en.notes %}\nNotes (EN): {{ event.en.notes }}{% endif %}
LOCATION:{{ event.location.name }}, {{ event.location.address }}, {{ event.location.city }}, {{ event.location.province }}, {{ event.location.postalCode }}, {{ event.location.country }}
{% if event.rrule %}RRULE:{{ event.rrule }}
{% endif %}{% if event.firstEventStartDate %}DTSTART;TZID=America/Montreal:{{ event.firstEventStartDate | remove: '-' }}T193000
DURATION:PT1H
{% elsif event.startDate %}DTSTART;VALUE=DATE:{{ event.startDate | remove: '-' }}
{% if event.endDate %}DTEND;VALUE=DATE:{{ event.endDate | remove: '-' }}
{% endif %}{% endif %}{% if event.fr.url %}URL:{{ event.fr.url }}
{% endif %}END:VEVENT
{% endfor %}END:VCALENDAR
